DB_HOST=localhost
DB_PORT=5432
DB_NAME=nova_erp
DB_USER=nova
DB_PASSWORD=nova_secret
DB_SCHEMA=Nova
DB_POOL_MIN=5
DB_POOL_MAX=20

# Authentication & JWT
# In production (NOVA_ENV=production or ENVIRONMENT=production), SECRET_KEY is strictly required,
# must be at least 32 characters long, and must not use insecure default/placeholder values.
# Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=240
REFRESH_TOKEN_EXPIRE_DAYS=7

ALLOWED_ORIGINS=*

# Billing (Stripe)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Analytics (PostHog)
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com

# Error Tracking (Sentry)
SENTRY_DSN=
RELEASE_VERSION=dev

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@novaerp.com
APP_URL=http://localhost:5173

# AI Assistant (OpenAI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Redis (Distributed State, MCP Tier 2 Actions & Rate Limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Optional REDIS_URL overrides REDIS_HOST, REDIS_PORT, REDIS_PASSWORD, and REDIS_DB if set
REDIS_URL=

# Reverse Proxy & Rate Limiting Configuration
# Comma-separated list of trusted reverse proxy IP addresses or subnets (e.g. 127.0.0.1, 10.0.0.0/8)
TRUSTED_PROXIES=127.0.0.1,::1
